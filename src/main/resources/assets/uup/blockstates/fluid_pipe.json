{
    "multipart": [
        {   "apply": { "model": "uup:block/fluid_pipe_core" } },
        {   "when": { "north": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm" }
        },
        {   "when": { "east": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm", "y": 90 }
        },
        {   "when": { "south": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm", "y": 180 }
        },
        {   "when": { "west": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm", "y": 270 }
        },
        {   "when": { "up": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm", "x": 270 }
        },
        {   "when": { "down": "true" },
            "apply": { "model": "uup:block/fluid_pipe_arm", "x": 90 }
        }
    ]
}
